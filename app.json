{
  "expo": {
    "name": "Math In 60 Seconds",
    "slug": "math-in-60-seconds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddlamar.mathin60seconds",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon-android.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.reddlamar.mathin60seconds",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1F44",
          "image": "./assets/splash-icon.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "10ed2607-4f20-45bd-a08a-00976efc506a"
      }
    },
    "owner": "lredd"
  }
}
